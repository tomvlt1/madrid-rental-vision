{
  "manifest_version": 3,
  "name": "CasaIntel: Peer rent for Idealista",
  "version": "0.2.0",
  "description": "Multimodal peer-rent estimator for Madrid Idealista listings. SigLIP + multilingual text + gradient boosting (R² 0.88, MAE €274 on 6,047 listings).",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.idealista.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.idealista.com/alquiler-viviendas/madrid*",
        "https://www.idealista.com/inmueble/*"
      ],
      "js": ["lib/jspdf.umd.min.js", "src/content.js"],
      "css": ["styles/injected.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CasaIntel"
  }
}
